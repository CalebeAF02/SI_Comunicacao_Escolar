@startuml DER_LOGICO_COMUNICACAO_ESCOLAR

skinparam linetype ortho
skinparam padding 10
skinparam margin 20
skinparam nodesep 100
skinparam ranksep 150
skinparam minClassWidth 150

entity PESSOA {
  * id : int <<PK>>
  --
  nome : varchar(100)
  email : varchar(100)
  telefone : varchar(20)
  senha_hash : varchar(255)
  nivel_acesso : varchar(30)
}

entity ALUNO {
  * pessoa_id : int <<PK,FK>>
  --
  matricula : varchar(20)
}

entity PAIS {
  * pessoa_id : int <<PK,FK>>
  --
  grau_parentesco : varchar(50)
}

entity PROFESSOR {
  * pessoa_id : int <<PK,FK>>
  --
  registro_funcional : varchar(30)
}

entity COORDENADOR {
  * pessoa_id : int <<PK,FK>>
  --
  setor : varchar(100)
}

entity DIRETOR {
  * pessoa_id : int <<PK,FK>>
}

entity TURMA {
  * id : int <<PK>>
  professor_orientador_id : int <<FK>>
  --
  nome : varchar(50)
  ano : int
  turno : varchar(20)
  inicio_vigencia : date
  fim_vigencia : date
}

entity DISCIPLINA {
  * id : int <<PK>>
  --
  nome : varchar(100)
  codigo : varchar(20)
}

entity TURMA_DISCIPLINA_PROFESSOR_HORARIO {
  * turma_id : int <<PK,FK>>
  * disciplina_id : int <<PK,FK>>
  * professor_id : int <<PK,FK>>
  * horario_id : int <<PK,FK>>
}

entity HORARIO {
  * id : int <<PK>>
  --
  dia_semana : enum
  hora_inicio : time
  hora_fim : time
}

entity ALUNO_TURMA {
  * aluno_id : int <<PK,FK>>
  * turma_id : int <<PK,FK>>
}

entity CATEGORIA_AVISO {
  * id : int <<PK>>
  --
  nome : varchar(100)
  exige_moderacao : boolean
}

entity AVISO {
  * id : int <<PK>>
  --
  autor_id : int <<FK>>
  categoria_id : int <<FK>>
  titulo : varchar(150)
  descricao : text
  arquivo : varchar(255)
  tipo : varchar(30)
  nivel_urgencia : varchar(20)
  data_criacao : datetime
  data_publicacao : datetime
  status : varchar(30)
}

entity SOLICITACAO_AUTORIZACAO {
  * id : int <<PK>>
  --
  aviso_id : int <<FK>>
  avaliador_id : int <<FK>>
  data_solicitacao : datetime
  data_avaliacao : datetime
  decisao : varchar(30)
  feedback : text
}

entity ENVIO {
  * id : int <<PK>>
  --
  aviso_id : int <<FK>>
  data_envio : datetime
  canal : varchar(30)
  tipo_segmentacao : varchar(30)
}

entity ENVIO_DESTINATARIO {
  * envio_id : int <<PK,FK>>
  * pessoa_id : int <<PK,FK>>
}

entity CONTROLE_RECEBIMENTO {
  * id : int <<PK>>
  --
  envio_destinatario_envio_id : int <<FK>>
  envio_destinatario_pessoa_id : int <<FK>>
  data_visualizacao : datetime
  data_recebimento : datetime
}

PESSOA <|-- ALUNO
PESSOA <|-- PAIS
PESSOA <|-- PROFESSOR
PESSOA <|-- COORDENADOR
PESSOA <|-- DIRETOR

ALUNO ||--o{ ALUNO_TURMA : matricula
TURMA ||--o{ ALUNO_TURMA : inclui

PROFESSOR ||--o{ TURMA : orienta

TURMA ||--o{ TURMA_DISCIPLINA_PROFESSOR_HORARIO : possui
DISCIPLINA ||--o{ TURMA_DISCIPLINA_PROFESSOR_HORARIO : compoe
PROFESSOR ||--o{ TURMA_DISCIPLINA_PROFESSOR_HORARIO : ministra
HORARIO ||--o{ TURMA_DISCIPLINA_PROFESSOR_HORARIO : define

CATEGORIA_AVISO ||--o{ AVISO : classifica
PESSOA ||--o{ AVISO : cria

AVISO ||--o{ SOLICITACAO_AUTORIZACAO : pode_requerer
PESSOA ||--o{ SOLICITACAO_AUTORIZACAO : avalia

AVISO ||--o{ ENVIO : gera
ENVIO ||--o{ ENVIO_DESTINATARIO : direciona
PESSOA ||--o{ ENVIO_DESTINATARIO : recebe

ENVIO_DESTINATARIO ||--|| CONTROLE_RECEBIMENTO : registra

@enduml
