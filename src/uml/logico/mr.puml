@startuml

skinparam linetype ortho
skinparam padding 10
skinparam margin 20
skinparam nodesep 100
skinparam ranksep 150
skinparam minClassWidth 150

entity PESSOA {
  * id : int <<PK>>
  usuario : varchar(100) unique
  email : varchar(100) unique
  --
  nome : varchar(100)
  cpf : int(11)
  telefone : varchar(20)
  senha_hash : varchar(255)
  nivel_acesso : varchar(30)
}

entity ALUNO {
  * pessoa_id : int <<PK,FK>>
  --
  matricula : varchar(20)
  serie : varchar(20)
}

entity RESPONSAVEL {
  * pessoa_id : int <<PK,FK>>
  --
  telefone_emergencia : varchar(20)
}

entity PARENTESCO {
  * aluno_id : int <<PK,FK>>
  * responsavel_id : int <<PK,FK>>
  --
  grau_parentesco : varchar(50)
}

entity FUNCIONARIO {
  * pessoa_id : int <<PK,FK>>
  --
  registro_funcional : varchar(30)
}

entity FUNCIONARIO_CATEGORIA {
  * funcionario_id : int <<PK,FK>>
  * categoria_id : int <<PK,FK>>
}

entity CATEGORIA {
  * id : int <<PK>>
  --
  tipo : enum("PROFESSOR", "CORDENADOR", "DIRETOR", "CANTINA", "SEGURANCA", "FAXINA")
}

entity TURMA {
  * id : int <<PK>>
  professor_orientador_id : int <<FK>>
  --
  nome : varchar(50)
  ano : int
  turno : varchar(20)
  inicio_vigencia : date
  fim_vigencia : date
}

entity DISCIPLINA {
  * id : int <<PK>>
  --
  nome : varchar(100)
  codigo : varchar(20)
}

entity TURMA_DISCIPLINA_FUNCIONARIO_HORARIO {
  * id : int <<PK>>
  turma_id : int <<FK>>
  disciplina_id : int <<FK>>
  professor_id : int <<FK>>
  horario_id : int <<FK>>
}

entity HORARIO {
  * id : int <<PK>>
  --
  dia_semana : enum
  hora_inicio : time
  hora_fim : time
}

entity CATEGORIA_AVISO {
  * id : int <<PK>>
  --
  tipo : enum("TURMA","SERIE","ALUNO","RESPONSAVEL","TODOS")
  valor : varchar(250)
  exige_moderacao : boolean
}

entity AVISO {
  * id : int <<PK>>
  autor_id : int <<FK>>
  categoria_id : int <<FK>>
  --
  titulo : varchar(150)
  descricao : text
  formato : enum("TEXTO","IMAGEM","DOCUMENTO")
  url : varchar(500)
  nivel_urgencia : varchar(20)
  data_criacao : datetime
  data_publicacao : datetime
  status : varchar(30)
}

entity SOLICITACAO_AUTORIZACAO {
  * id : int <<PK>>
  aviso_id : int <<FK>>
  avaliador_id : int <<FK>>
  --
  data_solicitacao : datetime
  data_avaliacao : datetime
  status : enum("CONFIRMADA","RECUSADA","EM_ANALISE","NAO_VISUALIZADA","CORRECAO")
  feedback : text
}

entity ENVIO {
  * id : int <<PK>>
  aviso_id : int <<FK>>
  --
  data_envio : datetime
  canal : varchar(30)
  tipo_segmentacao : varchar(30)
}

entity VISUALIZACAO {
  * aviso_id : int <<PK,FK>>
  * pessoa_id : int <<PK,FK>>
  --
  data_hora_visualizacao : datetime
}

entity REACAO_AVISO {
  * aviso_id : int <<PK,FK>>
  * pessoa_id : int <<PK,FK>>
  --
  tipo : enum("CURTIR","DUVIDA","IMPORTANTE")
}

entity COMENTARIO {
  * id : int <<PK>>
  aviso_id : int <<FK>>
  pessoa_id : int <<FK>>
  --
  texto : text
  data_criacao : datetime
}

PESSOA <|-- ALUNO
PESSOA <|-- RESPONSAVEL
PESSOA <|-- FUNCIONARIO

FUNCIONARIO ||--o{ FUNCIONARIO_CATEGORIA : possui
CATEGORIA ||--o{ FUNCIONARIO_CATEGORIA : classifica

ALUNO ||--o{ TURMA : matricula

FUNCIONARIO ||--o{ TURMA : orienta

TURMA ||--o{ TURMA_DISCIPLINA_FUNCIONARIO_HORARIO : possui
DISCIPLINA ||--o{ TURMA_DISCIPLINA_FUNCIONARIO_HORARIO : compoe
FUNCIONARIO ||--o{ TURMA_DISCIPLINA_FUNCIONARIO_HORARIO : ministra
HORARIO ||--o{ TURMA_DISCIPLINA_FUNCIONARIO_HORARIO : define

RESPONSAVEL ||--o{ PARENTESCO : compoe
ALUNO ||--o{ PARENTESCO : compoe

AVISO ||--o{ REACAO_AVISO  : compoe
PESSOA ||--o{ REACAO_AVISO  : compoe

AVISO ||--o{ COMENTARIO   : compoe
PESSOA ||--o{ COMENTARIO   : compoe

CATEGORIA_AVISO ||--o{ AVISO : classifica
FUNCIONARIO ||--o{ AVISO : cria

AVISO ||--o{ SOLICITACAO_AUTORIZACAO : pode_requerer
FUNCIONARIO ||--o{ SOLICITACAO_AUTORIZACAO : avalia

AVISO ||--o{ ENVIO : gera
PESSOA ||--o{ VISUALIZACAO : recebe

AVISO ||--|| VISUALIZACAO : registra


note right of PARENTESCO
  PK = (aluno_id,responsavel_id)
end note

note right of FUNCIONARIO_CATEGORIA
  PK = (funcionario_id,categoria_id)
end note

note right of VISUALIZACAO
  PK = (aviso_id,pessoa_id)
end note

note right of REACAO_AVISO 
  PK = (aviso_id,pessoa_id)
end note

@enduml